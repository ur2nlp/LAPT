/data/*
!/data/gothic_word_spotting/
# Track curated instruction-tuning data + provenance (incl. archive/); see
# data/gothic_instruct/MANIFEST.yaml. These artifacts are not reliably
# regenerable, so git is their canonical preservation.
!/data/gothic_instruct/
data/gothic_instruct/mix_*
# Re-ignore recomputable artifacts inside gothic_word_spotting/
/data/gothic_word_spotting/raw_llm/train_results_b*.jsonl
/data/gothic_word_spotting/raw_llm/test_results.jsonl
/data/gothic_word_spotting/diversification/diversify_results.jsonl
/data/gothic_word_spotting/diversification/diversify_run.log
/data/gothic_word_spotting/verification/train_verify.tsv
/data/gothic_word_spotting/verification/test_verify.tsv

models/
scripts/
tokenizers/
experiments/
plots/
presentations/
